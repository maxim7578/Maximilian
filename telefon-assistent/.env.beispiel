# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Die Datei .env enthält Passwörter – niemals weitergeben oder hochladen.

# --- Telegram (Schritt 1) ---
TELEGRAM_BOT_TOKEN=HIER_TOKEN_VON_BOTFATHER
# Leer lassen, Bot starten, /start schicken – dann zeigt der Bot deine Chat-ID an.
TELEGRAM_CHAT_ID=

# --- Groq, kostenlos (Schritt 2) ---
GROQ_API_KEY=HIER_GROQ_SCHLUESSEL

# --- FRITZ!Box-IP-Telefon (Schritt 3) ---
FRITZBOX_ADRESSE=192.168.178.1
FRITZBOX_BENUTZER=HIER_BENUTZERNAME
FRITZBOX_KENNWORT=HIER_KENNWORT

# --- Über dich ---
# So, wie es in den Satz "Hier ist der digitale Assistent von ..." passt,
# z. B. Herrn Mustermann oder Frau Mustermann (ohne Anführungszeichen)
INHABER_NAME=HIER_DEIN_NAME
# Für die Suche nach Telefonnummern, wenn im Auftrag kein Ort genannt ist
WOHNORT=
# Nummer, die der Assistent nennen darf, wenn jemand nach einem Rückruf fragt (leer = keine)
RUECKRUFNUMMER=

# --- Eingehende Anrufe auf deiner Festnetznummer annehmen? an / aus ---
EINGEHENDE_ANRUFE=aus

# --- Interne Einstellungen ---
# Beliebiges langes Passwort (nur Buchstaben und Ziffern), wird nur intern auf dem Laptop genutzt
ARI_KENNWORT=HIER_BELIEBIGES_LANGES_PASSWORT
LLM_MODELL=openai/gpt-oss-120b
STT_MODELL=whisper-large-v3-turbo
PIPER_STIMME=de_DE-thorsten-medium
MAX_GESPRAECH_SEKUNDEN=300

From 4457fe0ee6e653ea7f48adfd2549a9e59ba80597 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 17:00:42 +0000
Subject: [PATCH 4/4] fix: report metadata errors in PDF export instead of
 swallowing them

saveToPdf caught errors while rendering an account's metadata and only
printed them (or, for images, silently passed), then still returned
True. Broken metadata went unnoticed and the export test passed with
data missing from the PDF.

Errors are now logged via logError, the PDF is still written, a warning
names the affected accounts and saveToPdf returns False.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Bja6cd7jRHwAargZeaiYU9
---
 src/modules/export/pdf.py | 14 +++++++++++---
 tests/test_export.py      | 12 ++++++++++++
 2 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/src/modules/export/pdf.py b/src/modules/export/pdf.py
index d66f634..1113907 100644
--- a/src/modules/export/pdf.py
+++ b/src/modules/export/pdf.py
@@ -43,6 +43,7 @@ def saveToPdf(foundAccounts, resultType, config):
         width, height = letter
         canva = canvas.Canvas(path, pagesize=letter)
         accountsCount = len(foundAccounts)
+        failedAccounts = []
 
         canva.drawImage(
             os.path.join(
@@ -336,16 +337,23 @@ def saveToPdf(foundAccounts, resultType, config):
                                             height=35,
                                         )
                                         y_position -= 15
-                                    except:
-                                        pass
+                                    except Exception as e:
+                                        failedAccounts.append(result["name"])
+                                        logError(e, f"Coudn't add image of {result['name']} to PDF file!", config)
                         endWidth = y_position
                         canva.setStrokeColor("#CE0000")
                         canva.line(85, initialWidth, 85, endWidth)
                     y_position -= 25
                 except Exception as e:
-                    print(e)
+                    failedAccounts.append(result["name"])
+                    logError(e, f"Coudn't add metadata of {result['name']} to PDF file!", config)
         canva.save()
         config.console.print(f"💾  Saved results to '[cyan1]{fileName}[/cyan1]'")
+        if failedAccounts:
+            config.console.print(
+                f"⚠️  Some data is missing from the PDF file: {', '.join(dict.fromkeys(failedAccounts))}"
+            )
+            return False
         return True
     except Exception as e:
         logError(e, "Coudn't saved results to PDF file!", config)

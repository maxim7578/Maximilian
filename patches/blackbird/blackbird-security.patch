From 7810abb5715de766045fe4cb2a4f74a22cd83458 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 16:57:06 +0000
Subject: [PATCH 2/4] fix: enable TLS certificate verification for all HTTP
 requests

Both sync (requests) and async (aiohttp) requests skipped certificate
verification, leaving the AI API key and the downloaded site list open
to interception and tampering on the network.

- verify=False -> verify=True (requests)
- ssl=False -> ssl=True (aiohttp)
- stop silencing urllib3 warnings

Users running --proxy with an intercepting proxy need to trust its CA
via REQUESTS_CA_BUNDLE and SSL_CERT_FILE.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Bja6cd7jRHwAargZeaiYU9
---
 src/modules/utils/http_client.py | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)

diff --git a/src/modules/utils/http_client.py b/src/modules/utils/http_client.py
index d9d8dd7..dab1565 100644
--- a/src/modules/utils/http_client.py
+++ b/src/modules/utils/http_client.py
@@ -7,8 +7,6 @@ sys.path.append(os.path.join(os.path.dirname(__file__), "."))
 
 from log import logError
 
-requests.packages.urllib3.disable_warnings()
-
 
 # Perform a Sync Request and return response details
 def do_sync_request(method, url, config, data=None, customHeaders=None, cookies=None):
@@ -20,7 +18,7 @@ def do_sync_request(method, url, config, data=None, customHeaders=None, cookies=
         "method": method,
         "url": url,
         "timeout": config.timeout,
-        "verify": False,
+        "verify": True,
         "headers": headers,
         "data": data,
         "cookies": cookies,
@@ -56,7 +54,7 @@ async def do_async_request(method, url, session, config, data=None, customHeader
             proxy=proxy,
             timeout=config.timeout,
             allow_redirects=True,
-            ssl=False,
+            ssl=True,
             data=data,
             headers=headers,
             max_redirects=10,
-- 

+import { defineConfig } from 'vite';
+import tailwindcss from '@tailwindcss/vite';
+import { fileURLToPath } from 'node:url';
+
+export default defineConfig({
+    base: './',
+    plugins: [
+        tailwindcss(),
+    ],
+    resolve: {
+        // The Next.js app uses Tailwind v3; the Vite/Electron app needs v4,
+        // installed under the "tailwindcss-v4" alias.
+        alias: [{ find: /^tailwindcss$/, replacement: fileURLToPath(new URL('./node_modules/tailwindcss-v4/index.css', import.meta.url)) }],
+    },
+    css: {
+        // Don't pick up the root postcss.config.js (Tailwind v3, for Next.js).
+        postcss: { plugins: [] },
+    },
+    server: {
+        proxy: {
+            '/api': {
+                target: 'https://api.muapi.ai',
+                changeOrigin: true,
+                secure: false
+            }
+        }
+    }

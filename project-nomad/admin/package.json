    "@types/stopword": "2.0.3",
    "@types/stream-json": "1.7.7",
    "@types/yauzl": "2.10.3",
    "eslint": "9.39.2",
    "hot-hook": "1.0.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "youch": "4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "10.1.0",
